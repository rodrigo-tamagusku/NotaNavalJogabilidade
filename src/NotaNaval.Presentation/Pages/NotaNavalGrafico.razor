@using MudBlazor
@using NotaNaval.Domain.Entities

<MudPaper Style="@PaperStyle" Elevation="4">

    @* ── Título barra superior ─────────────────────────────────────── *@
    <div style="display:flex; justify-content:space-between; align-items:center;
        border-bottom: 1px solid #a080c0; padding: 6px 12px; margin-bottom: 0;">
        <div style="display:flex; align-items:center; gap:8px;">
            <MudIcon Icon="@Icons.Material.Filled.GridOn" Style="color:#d4b8f0; font-size:16px;" />
            <MudText Style="font-family:monospace; font-size:13px; font-weight:700;
                color:#d4b8f0; letter-spacing:1px;">
                ULTIMATE_NOTA_DEFINITIVA_NEM_ADIANTA
            </MudText>
        </div>
    </div>

    @* ── Área do gráfico ───────────────────────────────────────────── *@
    <div style="position:relative; padding: 16px 8px 8px 8px;">

        @* Label BOM (topo, centro) *@
        <div style="position:absolute; top:4px; left:50%; transform:translateX(-50%);
            text-align:center; z-index:2;">
            <MudText Style="@AxisLabelStyle">BOM</MudText>
        </div>

        @* Label RUIM (base, centro) — posicionado após o grid via margin *@

        @* Label DESINTERESSANTE (esquerda, meio) *@
        <div style="position:absolute; left:8px; top:50%; transform:translateY(-50%);
            text-align:center; z-index:2; max-width:60px; line-height:1.1;">
            <MudText Style="@AxisLabelStyle">DESINTE<br />RESSANTE</MudText>
        </div>

        @* Label INTERESSANTE (direita, meio) *@
        <div style="position:absolute; right:8px; top:50%; transform:translateY(-50%);
            text-align:center; z-index:2; max-width:60px; line-height:1.1;">
            <MudText Style="@AxisLabelStyle">INTERES<br />SANTE</MudText>
        </div>

        @* Grid com margens para os labels laterais *@
        <div style="margin: 24px 72px 0 72px; position:relative;">

            @* Linhas do grid *@
            @foreach (var yTick in YTicks)
            {
                <div style="display:flex; height:@(CellPx)px; position:relative;">

                    @* Tick Y (diamante) + label — apenas na metade esquerda do eixo central *@
                    @* Label Y no eixo central *@

                    @foreach (var xTick in XTicks)
                    {
                        bool isAxisX = xTick.IsAxis;
                        bool isAxisY = yTick.IsAxis;
                        var cellPoints = GetPoints(xTick.Value, yTick.Value);
                        bool showXTick = isAxisX && !yTick.IsAxis;
                        bool showYTick = isAxisY && !xTick.IsAxis;

                        <div style="flex:1; height:100%; position:relative;
                            border-right: @(isAxisX ? "1px solid #c0a0e0" : "1px dashed #6040a0");
                            border-bottom: @(isAxisY ? "1px solid #c0a0e0" : "1px dashed #6040a0");">

                            @* Tick diamante no eixo X (coluna 5→6) para essa linha *@
                            @if (isAxisX && !isAxisY)
                            {
                                <div style="position:absolute; right:-7px; top:50%;
                                    transform:translateY(-50%); z-index:3;">
                                    <MudText Style="color:#c0a0e0; font-size:10px; font-family:monospace;">
                                        ◇
                                    </MudText>
                                </div>
                            }

                            @* Label Y (letra A-J) no eixo vertical *@
                            @if (isAxisX && !isAxisY)
                            {
                                <div style="position:absolute; right:4px; bottom:2px; z-index:3;">
                                    <MudText Style="font-family:monospace; font-size:10px;
                                        color:#c0a0e0; font-style:italic;">
                                        @yTick.Label
                                    </MudText>
                                </div>
                            }

                            @* Tick diamante no eixo Y (linha E→F) para essa coluna *@
                            @if (isAxisY && !isAxisX)
                            {
                                <div style="position:absolute; left:50%; bottom:-7px;
                                    transform:translateX(-50%); z-index:3;">
                                    <MudText Style="color:#c0a0e0; font-size:10px; font-family:monospace;">
                                        ◇
                                    </MudText>
                                </div>
                            }

                            @* Label X (número 1-10) no eixo horizontal *@
                            @if (isAxisY && !isAxisX)
                            {
                                <div style="position:absolute; left:50%; bottom:2px;
                                    transform:translateX(-50%); z-index:3;">
                                    <MudText Style="font-family:monospace; font-size:9px;
                                        color:#c0a0e0; font-style:italic;">
                                        @xTick.Label
                                    </MudText>
                                </div>
                            }

                            @* Avatares dos participantes *@
                            @if (cellPoints.Any())
                            {
                                <div style="position:absolute; inset:0; display:flex;
                                    align-items:center; justify-content:center;
                                    gap:2px; flex-wrap:wrap; z-index:4;">
                                    @foreach (var pt in cellPoints)
                                    {
                                        <MudTooltip Text="@GetTooltip(pt)" Arrow="true" Placement="Placement.Top">
                                            <MudAvatar Size="Size.Small"
                                                       Style="width:24px; height:24px; font-size:10px;">
                                                <MudImage Src="@pt.Avaliador.IconeUrl" Alt="@pt.Avaliador.Nome" />
                                            </MudAvatar>
                                        </MudTooltip>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @* Label RUIM abaixo do grid *@
            <div style="text-align:center; margin-top:6px;">
                <MudText Style="@AxisLabelStyle">RUIM</MudText>
            </div>

        </div>
    </div>

    <MudPaper Class="pa-4 pa-sm-6 mb-4 mb-md-6 d-flex flex-column mud-theme-primary align-center" Elevation="4">
        <div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;">
            @foreach (var avaliador in Avaliadores)
            {
                <div style="display: flex; align-items: center; gap: 6px;">
                    <MudAvatar Size="Size.Small"
                               Style="width:24px; height:24px; font-size:10px;">
                        <MudImage Src="@avaliador.IconeUrl" Alt="@avaliador.Nome" />
                    </MudAvatar>
                    <MudText Typo="Typo.body2">@avaliador.Nome</MudText>
                </div>
            }
        </div>
    </MudPaper>
</MudPaper>

@code {

    [Parameter] public List<NotaNavalJogo> Items { get; set; } = new();

    // ── Estilos ─────────────────────────────────────────────────────────────

    private string PaperStyle =>
        "background: linear-gradient(135deg, #2a0a4a 0%, #1a0535 40%, #2d1060 100%);" +
        "border: 1px solid #a080c0; border-radius: 4px; overflow:hidden;";

    private string AxisLabelStyle =>
        "font-family:monospace; font-size:11px; font-weight:700; " +
        "color:#e8d0ff; letter-spacing:1px;";

    private string AvatarStyle =>
        "width:48px; height:48px; border:2px solid #c0a0e0; " +
        "box-shadow: 0 0 8px rgba(192,160,224,0.5);";

    // ── Ticks ────────────────────────────────────────────────────────────────

    private record Tick(string Label, int Value, bool IsAxis);

    // X: Interessancia 1→10. IsAxis = entre col 5 e 6 (marca a coluna 5, borda direita = eixo)
    private List<Tick> XTicks { get; } = new()
    {
        new("1",  -5, false), new("2", -4, false), new("3", -3, false),
        new("4",  -2, false), new("5", -1, true),
        new("6",   1, false), new("7",  2, false), new("8",  3, false),
        new("9",   4, false), new("10", 5, false),
    };

    // Y: Qualidade A→J top-to-bottom. IsAxis = entre linha E e F (marca linha E, borda inferior = eixo)
    private List<Tick> YTicks { get; } = new()
    {
        new("A",  5, false), new("B",  4, false), new("C",  3, false),
        new("D",  2, false), new("E",  1, true),
        new("F", -1, false), new("G", -2, false), new("H", -3, false),
        new("I", -4, false), new("J", -5, false),
    };

    private int CellPx => 56;

    // ── Helpers ──────────────────────────────────────────────────────────────

    private List<NotaNavalJogo> GetPoints(int xVal, int yVal)
        => Items
            .Where(p => (int)p.Interessancia == xVal && (int)p.Qualidade == yVal)
            .ToList();

    private string GetTooltip(NotaNavalJogo pt)
        => $"{pt.Jogo.Nome.TrimStart('_').Replace("_", " ")} — " +
           $"{pt.Avaliador.Nome.ToString()} | Nota: {pt.Qualidade}{pt.Interessancia.ToString().TrimStart('_')}";

    private string GetAvatarUrl(Participante avaliador)
        => avaliador.IconeUrl ?? string.Empty;

    private IEnumerable<Participante> Avaliadores
        => Items.Select(p => p.Avaliador).Distinct();
}
